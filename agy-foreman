#!/usr/bin/env bash
# agy-foreman, portable (Linux/macOS). Run ./agy-foreman setup the first time.
# Uses Node.js 20+ if the computer has it, otherwise downloads a private copy into ./.runtime/node
# (checked against the official checksum). Nothing is installed system-wide.
set -euo pipefail
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export AGY_CALLER_CWD="$PWD"
cd "$SELF"

NODE_VERSION="22.12.0"
RUNTIME="$SELF/.runtime/node"

node_ok() { "$1" -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 20 ? 0 : 1)' 2>/dev/null; }

NODE=""
if [ -x "$RUNTIME/bin/node" ] && node_ok "$RUNTIME/bin/node"; then NODE="$RUNTIME/bin/node"
elif command -v node >/dev/null 2>&1 && node_ok "$(command -v node)"; then NODE="$(command -v node)"
fi

if [ -z "$NODE" ]; then
  case "$(uname -s)" in Linux) os=linux ;; Darwin) os=darwin ;; *) echo "Unsupported system: $(uname -s)"; exit 1 ;; esac
  case "$(uname -m)" in x86_64|amd64) arch=x64 ;; aarch64|arm64) arch=arm64 ;; armv7l) arch=armv7l ;; *) echo "Unsupported CPU: $(uname -m)"; exit 1 ;; esac
  name="node-v$NODE_VERSION-$os-$arch"
  base="https://nodejs.org/dist/v$NODE_VERSION"
  echo "Node.js 20+ not found. Downloading a private copy ($name)…"
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  fetch() { if command -v curl >/dev/null 2>&1; then curl -fsSL "$1" -o "$2"; else wget -q "$1" -O "$2"; fi; }
  fetch "$base/$name.tar.gz" "$tmp/node.tar.gz" || { echo "Download failed. Check your internet connection, or install Node.js 20+ from https://nodejs.org"; exit 1; }
  fetch "$base/SHASUMS256.txt" "$tmp/SHASUMS256.txt"
  expected="$(grep " $name.tar.gz\$" "$tmp/SHASUMS256.txt" | cut -d' ' -f1)"
  if command -v sha256sum >/dev/null 2>&1; then actual="$(sha256sum "$tmp/node.tar.gz" | cut -d' ' -f1)"; else actual="$(shasum -a 256 "$tmp/node.tar.gz" | cut -d' ' -f1)"; fi
  if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then echo "Checksum mismatch; refusing to use the download."; exit 1; fi
  mkdir -p "$RUNTIME"
  tar -xzf "$tmp/node.tar.gz" -C "$RUNTIME" --strip-components=1
  NODE="$RUNTIME/bin/node"
  if ! "$NODE" --version >/dev/null 2>&1; then
    rm -rf "$RUNTIME"
    echo "The downloaded Node.js does not run on this computer (macOS older than 13.5?)."
    echo "Install Node.js 20+ from https://nodejs.org (an older release if your macOS is old) and run this again."
    exit 1
  fi
fi

export PATH="$(dirname "$NODE"):$PATH"
exec "$NODE" scripts/portable.mjs "$@"
